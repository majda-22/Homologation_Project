# Copier ce fichier en .env et adapter si besoin.
# .env n'est jamais versionné (voir .gitignore).

# --- Base de données ---
# Chemin relatif à la racine du projet.
DATABASE_PATH=data/r116.db

# --- Logging ---
# Niveaux possibles : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/r116.log

# --- Application ---
APP_ENV=development
